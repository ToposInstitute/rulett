      <species id="s_1" name="A [phos [], emptyA []]" compartment="default" initialAmount="0" hasOnlySubstanceUnits="true"/>
      <species id="s_2" name="B [emptyB []]" compartment="default" initialAmount="0" hasOnlySubstanceUnits="true"/>
      <species id="s_3" name="K []" compartment="default" initialAmount="1" hasOnlySubstanceUnits="true"/>
      <species id="s_4" name="let bond [] in (A [unphos [], 0.0], B [0.1])" compartment="default" initialAmount="0" hasOnlySubstanceUnits="true"/>
